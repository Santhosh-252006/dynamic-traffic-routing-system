{
	"info": {
		"_postman_id": "a9b8c7d6-e5f4-4321-89ab-0123456789cd",
		"name": "Dynamic Traffic Routing System API",
		"description": "Complete Postman collection for authentication, road network management, real-time traffic simulation, Dijkstra route optimization, history, and analytical reports.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Jane Commuter\",\n  \"email\": \"jane@traffic.com\",\n  \"password\": \"User@123\",\n  \"role\": \"ROLE_USER\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
					}
				},
				{
					"name": "Login Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.environment.set(\"jwtToken\", jsonData.accessToken);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@traffic.com\",\n  \"password\": \"Admin@123\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
					}
				},
				{
					"name": "Get Current Profile",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
					}
				}
			]
		},
		{
			"name": "Route Optimization (Dijkstra)",
			"item": [
				{
					"name": "Find Optimal Route (Fastest)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"source\": \"INT-01\",\n  \"destination\": \"INT-04\",\n  \"optimizationMode\": \"FASTEST\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/routes/find", "host": ["{{baseUrl}}"], "path": ["api", "routes", "find"] }
					}
				},
				{
					"name": "Find Optimal Route (Shortest)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"source\": \"INT-01\",\n  \"destination\": \"INT-04\",\n  \"optimizationMode\": \"SHORTEST\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/routes/find", "host": ["{{baseUrl}}"], "path": ["api", "routes", "find"] }
					}
				},
				{
					"name": "Get Route History",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/routes/history", "host": ["{{baseUrl}}"], "path": ["api", "routes", "history"] }
					}
				}
			]
		},
		{
			"name": "Road Network Management",
			"item": [
				{
					"name": "Get All Roads",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/roads", "host": ["{{baseUrl}}"], "path": ["api", "roads"] }
					}
				},
				{
					"name": "Get Intersections (Nodes)",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/intersections", "host": ["{{baseUrl}}"], "path": ["api", "intersections"] }
					}
				},
				{
					"name": "Update Road Status (Admin)",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"trafficLevel\": \"HEAVY\",\n  \"roadStatus\": \"OPEN\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/traffic/1", "host": ["{{baseUrl}}"], "path": ["api", "traffic", "1"] }
					}
				},
				{
					"name": "Trigger Traffic Simulation Flux",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/traffic/simulate", "host": ["{{baseUrl}}"], "path": ["api", "traffic", "simulate"] }
					}
				}
			]
		},
		{
			"name": "Reports & Analytics",
			"item": [
				{
					"name": "Dashboard Metrics",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/reports/dashboard", "host": ["{{baseUrl}}"], "path": ["api", "reports", "dashboard"] }
					}
				},
				{
					"name": "Detailed Statistics",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/reports/statistics", "host": ["{{baseUrl}}"], "path": ["api", "reports", "statistics"] }
					}
				},
				{
					"name": "Export History CSV",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/reports/export/csv", "host": ["{{baseUrl}}"], "path": ["api", "reports", "export", "csv"] }
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080" }
	]
}
